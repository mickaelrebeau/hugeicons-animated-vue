84 4.10826 9.25688 3.8688C9.39812 3.75972 9.5251 3.62385 9.77907 3.35212Z\" stroke=\"currentColor\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '12px 12px' }\" />\n            <motion.path d=\"M14.0842 10.5156C13.6532 9.9689 13.5452 9.35684 13.6835 8.7967C13.8549 8.1029 14.4535 7.83956 15.1169 8.09665C15.9467 8.4182 16.0867 9.52713 15.2844 9.91288C14.9102 10.0928 14.5042 10.2953 14.0842 10.5156ZM14.0842 10.5156C13.5515 10.7949 12.9963 11.1028 12.4545 11.4297L17 12.3437C14.8788 12.6484 10.6364 13.7148 12.4545 16C10.7771 15.1567 10.3034 14.59 10.1872 13.2578M10.1872 13.2578C10.1145 12.424 10.1819 11.2904 10.1819 9.60151M10.1872 13.2578C9.57935 14.0195 8.09092 15.1773 7 13.7148\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"frontVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '12px 11.92px' }\" />\n          </svg>\n        </div>\n</template>\n"
