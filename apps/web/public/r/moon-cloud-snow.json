      "path": "components/ui/moon-cloud-snow.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { motion, useAnimationControls } from 'motion-v'\nimport type { Variants } from 'motion-v'\nimport { useIconAnimation } from '../composables/useIconAnimation'\nimport type { AnimatedIconHandle } from '../types'\n\ndefineOptions({ inheritAttrs: false, name: 'MoonCloudSnowIcon' })\n\nwithDefaults(\n  defineProps<{\n    size?: number\n  }>(),\n  { size: 28 },\n)\n\n// after snow: the flake drifts sideways and turns as it falls\n// generated from @hugeicons/core-free-icons\nconst iconVariants: Variants = {\n  normal: {\n    transform: 'translate(0px, 0px) rotate(0deg)',\n  },\n  animate: {\n    transform: ['translate(0px, 0px) rotate(0deg)', 'translate(1.51px, 2.37px) rotate(19.35deg)', 'translate(-0.86px, 3.87px) rotate(-8.6deg)', 'translate(0px, 0px) rotate(0deg)'],\n    transition: {\n      duration: 0.99,\n      ease: [0.77, 0, 0.175, 1],\n    },\n  },\n}\n\nconst controls = useAnimationControls()\nconst { onMouseEnter, onMouseLeave, startAnimation, stopAnimation } = useIconAnimation({\n  controls,\n  loops: false,\n})\n\ndefineExpose<AnimatedIconHandle>({ startAnimation, stopAnimation })\n</script>\n\n<template>\n  <div class=\"hia-icon\" @mouseenter=\"onMouseEnter\" @mouseleave=\"onMouseLeave\" v-bind=\"$attrs\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" :width=\"size\" :height=\"size\" viewBox=\"0 0 24 24\" fill=\"none\" overflow=\"visible\">\n            <motion.path d=\"M17.4776 10.9869C17.485 10.9868 17.4925 10.9868 17.5 10.9868C19.9853 10.9868 22 12.9971 22 15.4768C22 17.2398 20.9817 18.7654 19.5 19.5001M17.4776 10.9869C17.4924 10.8225 17.5 10.6561 17.5 10.4879C17.5 7.45709 15.0376 5.00012 12 5.00012C9.12324 5.00012 6.76233 7.20384 6.52042 10.0117M17.4776 10.9869C17.395 11.9015 16.9769 12.6885 16.5 13.4182M6.52042 10.0117C3.98398 10.2525 2 12.384 2 14.9779C2 16.8245 3.0055 18.4368 4.5 19.2994M6.52042 10.0117C6.67826 9.99669 6.83823 9.98903 7 9.98903C8.12582 9.98903 9.16474 10.3603 10.0005 10.9868\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"iconVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '12px 12.25px' }\" />\n            <motion.path d=\"M10 5.13829C9.91652 4.70849 9.76249 4.28506 9.53351 3.88456C8.98606 2.92704 8.11203 2.27864 7.13552 2C7.28642 3.22635 6.71543 4.48154 5.58897 5.13829C4.46251 5.79504 3.10057 5.66681 2.1243 4.92166C1.87501 5.91497 1.99406 7.00354 2.54151 7.96107C3.48512 9.61151 5.39904 10.3436 7.13552 9.84664\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"iconVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '12px 12.25px' }\" />\n            <motion.path d=\"M8.125 15.75H8M12.125 17.75H12M16.125 15.75H16M16.125 19.75H16M12.125 21.75H12M8.125 19.75H8M8.25 15.75C8.25 15.8881 8.13807 16 8 16C7.86193 16 7.75 15.8881 7.75 15.75C7.75 15.6119 7.86193 15.5 8 15.5C8.13807 15.5 8.25 15.6119 8.25 15.75ZM12.25 17.75C12.25 17.8881 12.1381 18 12 18C11.8619 18 11.75 17.8881 11.75 17.75C11.75 17.6119 11.8619 17.5 12 17.5C12.1381 17.5 12.25 17.6119 12.25 17.75ZM16.25 15.75C16.25 15.8881 16.1381 16 16 16C15.8619 16 15.75 15.8881 15.75 15.75C15.75 15.6119 15.8619 15.5 16 15.5C16.1381 15.5 16.25 15.6119 16.25 15.75ZM16.25 19.75C16.25 19.8881 16.1381 20 16 20C15.8619 20 15.75 19.8881 15.75 19.75C15.75 19.6119 15.8619 19.5 16 19.5C16.1381 19.5 16.25 19.6119 16.25 19.75ZM12.25 21.75C12.25 21.8881 12.1381 22 12 22C11.8619 22 11.75 21.8881 11.75 21.75C11.75 21.6119 11.8619 21.5 12 21.5C12.1381 21.5 12.25 21.6119 12.25 21.75ZM8.25 19.75C8.25 19.8881 8.13807 20 8 20C7.86193 20 7.75 19.8881 7.75 19.75C7.75 19.6119 7.86193 19.5 8 19.5C8.13807 19.5 8.25 19.6119 8.25 19.75Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"iconVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '12px 12.25px' }\" />\n          </svg>\n        </div>\n</template>\n"
