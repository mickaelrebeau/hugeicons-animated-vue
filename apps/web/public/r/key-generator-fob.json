      "path": "components/ui/key-generator-fob.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { motion, useAnimationControls } from 'motion-v'\nimport type { Variants } from 'motion-v'\nimport { useIconAnimation } from '../composables/useIconAnimation'\nimport type { AnimatedIconHandle } from '../types'\n\ndefineOptions({ inheritAttrs: false, name: 'KeyGeneratorFobIcon' })\n\nwithDefaults(\n  defineProps<{\n    size?: number\n  }>(),\n  { size: 28 },\n)\n\n// after file-01: the body of the key generator fob lifts while its detail lines follow\n// generated from @hugeicons/core-free-icons\nconst fileVariants: Variants = {\n  normal: {\n    transform: 'translateY(0px) rotate(0deg)',\n  },\n  animate: {\n    transform: ['translateY(0px) rotate(0deg)', 'translateY(-0.87px) rotate(-1.08deg)', 'translateY(0.49px) rotate(0.54deg)', 'translateY(0px) rotate(0deg)'],\n    transition: {\n      duration: 0.61,\n      ease: [0.23, 1, 0.32, 1],\n    },\n  },\n}\n\nconst lineVariants: Variants = {\n  normal: {\n    transform: 'scaleX(1)',\n  },\n  animate: {\n    transform: ['scaleX(1)', 'scaleX(0.5)', 'scaleX(1.1)', 'scaleX(1)'],\n    transition: {\n      duration: 0.49,\n      delay: 0.12,\n      ease: [0.23, 1, 0.32, 1],\n    },\n  },\n}\n\nconst controls = useAnimationControls()\nconst { onMouseEnter, onMouseLeave, startAnimation, stopAnimation } = useIconAnimation({\n  controls,\n  loops: false,\n})\n\ndefineExpose<AnimatedIconHandle>({ startAnimation, stopAnimation })\n</script>\n\n<template>\n  <div class=\"hia-icon\" @mouseenter=\"onMouseEnter\" @mouseleave=\"onMouseLeave\" v-bind=\"$attrs\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" :width=\"size\" :height=\"size\" viewBox=\"0 0 24 24\" fill=\"none\" overflow=\"visible\">\n            <motion.path d=\"M8.37689 10H7.62311C6.1232 10 5.37325 10 4.83073 9.57641C4.28821 9.15282 4.10632 8.42526 3.74254 6.97014L3.05317 4.21268C3.01786 4.07143 3 3.92638 3 3.78078C3 2.79728 3.79728 2 4.78078 2H11.2192C12.2027 2 13 2.79728 13 3.78078C13 3.92638 12.9821 4.07143 12.9468 4.21268L12.2575 6.97014C11.8937 8.42526 11.7118 9.15282 11.1693 9.57641C10.6267 10 9.8768 10 8.37689 10Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '8px 6px' }\" />\n            <motion.path d=\"M7 6H9\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '8px 6px' }\" />\n            <motion.path d=\"M6 10V19.5858C6 19.9945 6 20.1989 6.07612 20.3827C6.15224 20.5665 6.29676 20.711 6.58579 21C7.25245 21.6667 7.58579 22 8 22C8.41421 22 8.74755 21.6667 9.41421 21C9.70324 20.711 9.84776 20.5665 9.92388 20.3827C10 20.1989 10 19.9945 10 19.5858V19L8.5 17.5L10 16V10\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '8px 16px' }\" />\n            <motion.path d=\"M13 5C14.8692 5 15.8038 5 16.5 5.40192C16.9561 5.66523 17.3348 6.04394 17.5981 6.5C18 7.19615 18 8.13077 18 10\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '15.5px 7.5px' }\" />\n            <motion.path d=\"M21 19V13C21 11.7824 21 11.1736 20.7025 10.7393C20.5838 10.566 20.434 10.4162 20.2607 10.2975C19.8264 10 19.2176 10 18 10C16.7824 10 16.1736 10 15.7393 10.2975C15.566 10.4162 15.4162 10.566 15.2975 10.7393C15 11.1736 15 11.7824 15 13V19C15 20.2176 15 20.8264 15.2975 21.2607C15.4162 21.434 15.566 21.5838 15.7393 21.7025C16.1736 22 16.7824 22 18 22C19.2176 22 19.8264 22 20.2607 21.7025C20.434 21.5838 20.5838 21.434 20.7025 21.2607C21 20.8264 21 20.2176 21 19Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"fileVariants\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '18px 16px' }\" />\n            <motion.path d=\"M15 16H21\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" :variants=\"lineVariants\" :custom=\"0\" :animate=\"controls\" initial=\"normal\" :style=\"{ transformOrigin: '15px 16px' }\" />\n          </svg>\n        </div>\n</template>\n"
