{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "garlands",
  "type": "registry:ui",
  "title": "garlands",
  "description": "Animated garlands icon for Vue",
  "dependencies": [
    "motion-v"
