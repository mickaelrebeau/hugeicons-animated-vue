{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "robotic",
  "type": "registry:ui",
  "title": "robotic",
  "description": "Animated robotic icon for Vue",
  "dependencies": [
    "motion-v"
