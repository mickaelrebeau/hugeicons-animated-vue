{
  "name": "hugeicons-animated-vue",
  "version": "0.4.0",
  "description": "Animated Hugeicons for Vue 3. Copy-paste source, or import the components.",
  "license": "MIT",
  "type": "module",
  "author": "Mickael Rébeau",
  "repository": {
    "type": "git",
    "url": "https://github.com/mickaelrebeau/hugeicons-animated-vue.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/mickaelrebeau/hugeicons-animated-vue/issues"
  },
  "homepage": "https://hugeicons-animated-vue.rebeaumickael.fr",
  "keywords": [
    "vue",
    "vue3",
    "icons",
    "hugeicons",
    "animated",
    "animation",
    "motion",
    "motion-v",
    "svg",
    "components"
  ],
  "sideEffects": [
    "./style.css"
  ],
  "files": [
    "dist",
    "style.css",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": "./dist/icons/*",
    "./composables/useIconAnimation": {
      "types": "./dist/composables/useIconAnimation.d.ts",
      "import": "./dist/composables/useIconAnimation.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./icon-approval": {
      "types": "./dist/icon-approval.d.ts",
      "import": "./dist/icon-approval.js"
    },
    "./style.css": "./style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "motion-v": "^1.7.0 || ^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "esbuild": "^0.28.2",
    "motion-v": "^2.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  }
}
