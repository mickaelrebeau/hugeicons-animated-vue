{
  "name": "hugeicons-animated-vue",
  "version": "0.1.0",
  "description": "Hand-animated Hugeicons for Vue 3. Copy-paste source, or import the components.",
  "license": "MIT",
  "type": "module",
  "author": "Mickael Rébeau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mickaelrebeau/hugeicons-animated-vue.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/mickaelrebeau/hugeicons-animated-vue/issues"
  },
  "homepage": "https://github.com/mickaelrebeau/hugeicons-animated-vue#readme",
  "keywords": [
