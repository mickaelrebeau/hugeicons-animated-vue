{
  "name": "hugeicons-animated-vue-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter hugeicons-animated-vue build && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "icons:convert": "node scripts/convert-icons.mjs",
    "registry:build": "node scripts/build-registry.mjs && node scripts/gen-manifest.mjs",
    "icons:check-rest": "node scripts/check-rest-parity.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "core-js"]
  }
}
